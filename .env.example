# Banco de dados (Postgres). Railway: referência ao serviço Postgres.
# Timeweb Cloud: string de conexão do cluster/banco Postgres provisionado.
DATABASE_URL="postgres://user:pass@host:5432/claros"

# Autenticação do painel admin (senha única + segredo de sessão >=16 chars)
ADMIN_PASSWORD=""
SESSION_SECRET=""

# URL pública do site (usada nas cobranças PIX)
SITE_URL="https://seu-dominio.com"

# Porta interna do processo. Railway injeta automaticamente; em hosts que não
# injetam (Timeweb Cloud, VPS, docker-compose) o default do Dockerfile é 3000.
# PORT=3000

# Kill switches do anti-bot (só em emergência / falso positivo):
# ANTI_BOT_OFF=1

# Gateways de pagamento (só os que for usar)
CASHINPAY_SECRET_KEY=""
# CASHINPAY_WEBHOOK_SECRET=""
# PROPIX_CLIENT_ID=""
# PROPIX_CLIENT_SECRET=""
# PIXZYPAY_TOKEN=""            # Bearer token gerado no painel PixzyPay
# M2PAY_API_KEY=""
# NOWBANKS_CLIENT_ID=""
# NOWBANKS_CLIENT_SECRET=""
# PIX_CHAVE=""
