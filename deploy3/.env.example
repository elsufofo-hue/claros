# Copie para `.env` (mesma pasta) e preencha. Nunca commite o `.env`.
# Este .env é INDEPENDENTE de ../deploy/.env — segundo par de domínios,
# isolado do primeiro, rodando na mesma VPS.

# ---- Domínios (o DNS deles precisa apontar para o IP da VPS ANTES de subir,
#      SEM proxy Cloudflare/CDN na frente — o Caddy precisa bater direto na
#      porta 80 pra validar o certificado Let's Encrypt) ----
SITE_DOMAIN=portalfaturaclaro.com
REDIRECT_DOMAIN=faturaclarofacil.com

# ---- Postgres: MESMO usuário/senha do stack original (../deploy/.env),
#      porque este stack se conecta ao container `db` já existente. ----
POSTGRES_USER=
POSTGRES_PASSWORD=

# Nomes dos bancos deste stack (criados por scripts/criar-bancos.sh).
# Só mude se quiser nomes diferentes do padrão.
SITE_DB=claros3
REDIRECT_DB=redirect3

# ---- Painel admin do site (/auth) ----
ADMIN_PASSWORD=
# gere com: openssl rand -hex 24   (>=16 chars)
SESSION_SECRET=

# ---- Admin do redirect (/_admin?token=...) ----
# gere com: openssl rand -hex 24
REDIRECT_ADMIN_TOKEN=

# ---- Gateways de pagamento (só os que for usar) ----
CASHINPAY_SECRET_KEY=
# Proxy de saída SÓ pras chamadas à CashinPay — ver deploy/.env.example.
# GATEWAY_PROXY_URL=
# PROPIX_CLIENT_ID=
# PROPIX_CLIENT_SECRET=
# PIXZYPAY_TOKEN=
# M2PAY_API_KEY=
# NOWBANKS_CLIENT_ID=
# NOWBANKS_CLIENT_SECRET=
# PIX_CHAVE=

# ---- Kill switches / testes do anti-bot ----
# ANTI_BOT_OFF=1
# ANTI_BOT_NO_ALLOWLIST=1
# REDIRECT_ANTI_BOT_OFF=1
# REDIRECT_ANTI_BOT_NO_ALLOWLIST=1
