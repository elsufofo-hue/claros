# Reverse proxy com HTTPS automático (Let's Encrypt).
# Caddy resolve os certificados sozinho no primeiro acesso a cada domínio —
# basta o DNS dos dois domínios já apontar para o IP da VPS antes de subir.

{
	email {$TLS_EMAIL}
}

# ---- Site principal (claros) ----
{$SITE_DOMAIN} {
	encode zstd gzip
	reverse_proxy site:3000 {
		# Repassa o IP real do visitante (o anti-bot e os formatadores usam).
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}
}

# ---- Serviço de redirect ----
{$REDIRECT_DOMAIN} {
	encode zstd gzip
	reverse_proxy redirect:8080 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}
}

# Stacks adicionais (ex.: deploy2/) entram por import, em arquivo separado —
# nunca editar blocos de outro stack aqui diretamente. Ver deploy2/Caddyfile.snippet
# e deploy2/README.md para como plugar. `import` de um glob que não bate em nada
# é um no-op silencioso, então isto é seguro mesmo sem nenhum stack extra.
import /etc/caddy/extra.d/*.caddy
