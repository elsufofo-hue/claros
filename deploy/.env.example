# Copie para `.env` (mesma pasta) e preencha. Nunca commite o `.env`.

# ---- Domínios (o DNS deles precisa apontar para o IP da VPS ANTES de subir) ----
SITE_DOMAIN=claros.seudominio.com
REDIRECT_DOMAIN=ir.seudominio.com
TLS_EMAIL=guilhermeryukaii@gmail.com

# ---- Postgres (um servidor, dois bancos: claros + redirect) ----
POSTGRES_USER=claros
# gere com: openssl rand -hex 24
POSTGRES_PASSWORD=

# ---- Painel admin do site (/auth) ----
ADMIN_PASSWORD=
# gere com: openssl rand -hex 24   (>=16 chars)
SESSION_SECRET=

# ---- Admin do redirect (/_admin?token=...) ----
# gere com: openssl rand -hex 24
REDIRECT_ADMIN_TOKEN=

# ---- Gateways de pagamento (só os que for usar) ----
CASHINPAY_SECRET_KEY=
# Assinatura HMAC dos webhooks da CashinPay (header X-CashinPay-Signature).
# Sem isso, o webhook é aceito sem validar a assinatura.
CASHINPAY_WEBHOOK_SECRET=
# Proxy de saída SÓ pras chamadas à CashinPay — usar se ela bloquear o IP
# desta VPS (TCP não fecha handshake; confirmar com MTR antes de assumir).
# Formato: http://usuario:senha@host:porta
# GATEWAY_PROXY_URL=
# PROPIX_CLIENT_ID=
# PROPIX_CLIENT_SECRET=
# PIXZYPAY_TOKEN=            # Bearer token do painel PixzyPay
# M2PAY_API_KEY=
# NOWBANKS_CLIENT_ID=
# NOWBANKS_CLIENT_SECRET=
# PIX_CHAVE=

# ---- Kill switches do anti-bot (só em emergência) ----
# ANTI_BOT_OFF=1
# REDIRECT_ANTI_BOT_OFF=1
